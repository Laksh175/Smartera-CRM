# Smartera Digital CRM Environment Configuration

PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication
JWT_SECRET=smartera_super_secret_jwt_key_2026_marketing_agency_crm
JWT_EXPIRES_IN=7d

# Supabase / PostgreSQL Connection
# If DATABASE_URL is not set or PostgreSQL is unavailable, the server automatically uses
# the resilient built-in in-memory / JSON persistence store with full relational capabilities.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartera_crm
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY must NEVER be passed to client frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Client URL
CLIENT_URL=http://localhost:5173
